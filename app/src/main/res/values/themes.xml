<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ArcDisney" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The system splash is plain night blue with no icon, so the app's own
         Disney splash takes over from it without a visible seam. -->
    <style name="Theme.ArcDisney.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.ArcDisney</item>
    </style>
</resources>
